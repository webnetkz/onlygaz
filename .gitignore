/target
**/*.rs.bk
*.pdb
.DS_Store
__pycache__/
*.pyc

# Build output is reproducible from the checked-in sources and assets.
# Keep the original Microsoft Store artwork, but not duplicate MSIX staging
# trees or package binaries, in the source repository.
/dist/*
!/dist/OnlyGAZ_StoreAssets/

# Android build: Cargo output, android/build_apk.sh staging and APKs, and the
# Gradle / Android Studio files that are created locally (local.properties
# holds the path of the Android SDK on this computer).
/android/target
/android/build
/android/.gradle
/android/.kotlin
/android/.idea
/android/local.properties
/android/captures
/android/app/build
/android/app/release
/android/buildSrc/build
/android/buildSrc/.gradle
*.iml
# Release signing key and its password. Back these up privately: every update
# of the installed app must be signed with the same key. Never commit them.
/android/keystore
