<?xml version="1.0" encoding="utf-8"?>
<!--
  OnlyGAZ for Android. The game is the native library libonlygaz.so (Rust +
  Bevy) started by NativeActivity; MainActivity only adds immersive full
  screen, cut-out insets and the display rotation. The game runs in
  landscape and follows the phone when it is turned over by 180 degrees.

  Package name, version, minSdk and targetSdk come from Gradle
  (android/app/build.gradle.kts and android/gradle.properties);
  android/build_apk.sh inserts the same values when it packages without
  Gradle.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="auto">

    <!-- Rendering uses Vulkan, with OpenGL ES 3 as the fallback. -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />
    <uses-feature android:name="android.hardware.screen.landscape" android:required="true" />
    <!-- Tilt steering is optional; the on-screen arrows always work. -->
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />

    <!--
      appCategory="game" also exempts the game from Android 16's override of
      screenOrientation / resizeableActivity on tablets and foldables.
    -->
    <application
        android:label="${appLabel}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/OnlyGazTheme"
        android:hasCode="true"
        android:isGame="true"
        android:appCategory="game"
        android:allowBackup="true"
        android:resizeableActivity="false"
        android:hardwareAccelerated="true">

        <!--
          enableOnBackInvokedCallback="false": the system Back button / gesture
          is delivered to the game as a key event (pause, previous page, quit)
          instead of closing the activity with the predictive-back animation
          that Android 16 enables for apps targeting API 36.
        -->
        <activity
            android:name=".MainActivity"
            android:label="${appLabel}"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="false"
            android:alwaysRetainTaskState="true"
            android:enableOnBackInvokedCallback="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation|uiMode|fontScale|layoutDirection|locale|mcc|mnc|touchscreen">

            <!-- Native library loaded by NativeActivity: lib/<abi>/libonlygaz.so -->
            <meta-data android:name="android.app.lib_name" android:value="onlygaz" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
